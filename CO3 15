        "# ============================================================\n",
        "# Bayesian Belief Network — Construction, Inference & Sensitivity\n",
        "# Domain: Home Security Alarm (Pearl's Burglary network)\n",
        "# Just paste this whole cell into Google Colab and run it.\n",
        "# Only needs numpy + matplotlib, both preinstalled in Colab.\n",
        "# ============================================================\n",
        "\n",
        "import copy\n",
        "from itertools import product\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import FancyBboxPatch, FancyArrowPatch\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. NETWORK DEFINITION\n",
        "# ------------------------------------------------------------\n",
        "# Nodes: Burglary(B), Earthquake(E), Alarm(A), JohnCalls(J), MaryCalls(M)\n",
        "# Edges: B->A, E->A, A->J, A->M   (all variables Boolean)\n",
        "\n",
        "VARS = [\"B\", \"E\", \"A\", \"J\", \"M\"]\n",
        "PARENTS = {\"B\": [], \"E\": [], \"A\": [\"B\", \"E\"], \"J\": [\"A\"], \"M\": [\"A\"]}\n",
        "\n",
        "def default_cpts():\n",
        "    \"\"\"Baseline conditional probability tables: P(var=True | parents).\"\"\"\n",
        "    return {\n",
        "        \"B\": {(): 0.001},\n",
        "        \"E\": {(): 0.002},\n",
        "        \"A\": {\n",
        "            (True, True): 0.95,\n",
        "            (True, False): 0.94,\n",
        "            (False, True): 0.29,\n",
        "            (False, False): 0.001,\n",
        "        },\n",
        "        \"J\": {(True,): 0.90, (False,): 0.05},\n",
        "        \"M\": {(True,): 0.70, (False,): 0.01},\n",
        "    }\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXACT INFERENCE ENGINE (enumeration-ask)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def p_true(var, parent_values, cpts):\n",
        "    return cpts[var][parent_values]\n",
        "\n",
        "def joint_prob(assignment, cpts):\n",
        "    \"\"\"P(B,E,A,J,M) for one full assignment via the chain rule.\"\"\"\n",
        "    prob = 1.0\n",
        "    for var in VARS:\n",
        "        parents = PARENTS[var]\n",
        "        parent_vals = tuple(assignment[p] for p in parents)\n",
        "        pt = p_true(var, parent_vals, cpts)\n",
        "        prob *= pt if assignment[var] else (1 - pt)\n",
        "    return prob\n",
        "\n",
        "def enumeration_ask(query_var, evidence, cpts):\n",
        "    \"\"\"Exact P(query_var | evidence) via full joint enumeration.\"\"\"\n",
        "    hidden = [v for v in VARS if v != query_var and v not in evidence]\n",
        "    result = {}\n",
        "    for qval in (True, False):\n",
        "        total = 0.0\n",
        "        base = dict(evidence)\n",
        "        base[query_var] = qval\n",
        "        for combo in product([True, False], repeat=len(hidden)):\n",
        "            assignment = dict(base)\n",
        "            assignment.update(dict(zip(hidden, combo)))\n",
        "            total += joint_prob(assignment, cpts)\n",
        "        result[qval] = total\n",
        "    z = result[True] + result[False]\n",
        "    return {k: v / z for k, v in result.items()}\n",
        "\n",
        "def query(var, evidence=None, cpts=None):\n",
        "    \"\"\"Convenience wrapper returning P(var=True | evidence).\"\"\"\n",
        "    if cpts is None:\n",
        "        cpts = default_cpts()\n",
        "    if evidence is None:\n",
        "        evidence = {}\n",
        "    return enumeration_ask(var, evidence, cpts)[True]\n",
        "\n",
        "def full_joint_check(cpts):\n",
        "    total = 0.0\n",
        "    for combo in product([True, False], repeat=5):\n",
        "        assignment = dict(zip(VARS, combo))\n",
        "        total += joint_prob(assignment, cpts)\n",
        "    return total\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. SANITY CHECK\n",
        "# ------------------------------------------------------------\n",
        "print(\"=\" * 70)\n",
        "print(\"SANITY CHECK\")\n",
        "print(\"=\" * 70)\n",
        "cpts = default_cpts()\n",
        "print(\"Joint distribution sums to:\", round(full_joint_check(cpts), 6))\n",
        "print(\"P(Burglary=T) prior          =\", round(query(\"B\", {}, cpts), 6))\n",
        "print(\"P(Burglary=T | John)         =\", round(query(\"B\", {\"J\": True}, cpts), 6))\n",
        "print(\"P(Burglary=T | John, Mary)   =\",\n",
        "      round(query(\"B\", {\"J\": True, \"M\": True}, cpts), 6))\n",
        "print(\"(These should match the classic textbook values: 0.001, 0.0163, 0.2842)\\n\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. NETWORK DIAGRAM\n",
        "# ------------------------------------------------------------\n",
        "fig, ax = plt.subplots(figsize=(9, 7))\n",
        "ax.set_xlim(0, 10); ax.set_ylim(0, 10); ax.axis(\"off\")\n",
        "\n",
        "nodes = {\n",
        "    \"B\": (2.2, 8.3, \"Burglary\"),\n",
        "    \"E\": (7.8, 8.3, \"Earthquake\"),\n",
        "    \"A\": (5.0, 5.7, \"Alarm\"),\n",
        "    \"J\": (2.2, 2.6, \"JohnCalls\"),\n",
        "    \"M\": (7.8, 2.6, \"MaryCalls\"),\n",
        "}\n",
        "colors = {\"B\": \"#f5b7b1\", \"E\": \"#f5b7b1\", \"A\": \"#f9e79f\", \"J\": \"#aed6f1\", \"M\": \"#aed6f1\"}\n",
        "\n",
        "for key, (x, y, label) in nodes.items():\n",
        "    box = FancyBboxPatch((x - 0.9, y - 0.5), 1.8, 1.0,\n",
        "                           boxstyle=\"round,pad=0.05,rounding_size=0.15\",\n",
        "                          linewidth=1.5, edgecolor=\"#333333\", facecolor=colors[key])\n",
        "    ax.add_patch(box)\n",
        "    ax.text(x, y, label, ha=\"center\", va=\"center\", fontsize=12, fontweight=\"bold\")\n",
        "\n",
        "for src, dst in [(\"B\", \"A\"), (\"E\", \"A\"), (\"A\", \"J\"), (\"A\", \"M\")]:\n",
        "    x1, y1, _ = nodes[src]; x2, y2, _ = nodes[dst]\n",
        "    arrow = FancyArrowPatch((x1, y1 - 0.5) if y1 > y2 else (x1, y1 + 0.5),\n",
        "                            (x2, y2 + 0.5) if y2 < y1 else (x2, y2 - 0.5),\n",
        "                            arrowstyle=\"-|>\", mutation_scale=20, linewidth=1.5,\n",
        "                            color=\"#555555\", connectionstyle=\"arc3,rad=0.08\")\n",
        "    ax.add_patch(arrow)\n",
        "\n",
        "ax.text(2.2, 9.15, \"P(B=T) = 0.001\", ha=\"center\", fontsize=9, color=\"#555\")\n",
        "ax.text(7.8, 9.15, \"P(E=T) = 0.002\", ha=\"center\", fontsize=9, color=\"#555\")\n",
        "ax.text(5.0, 4.35,\n",
        "        \"P(A=T | B,E)\\nB=T,E=T: 0.95\\nB=T,E=F: 0.94\\nB=F,E=T: 0.29\\nB=F,E=F: 0.001\",\n",
        "        ha=\"center\", va=\"top\", fontsize=8.5,\n",
        "        bbox=dict(boxstyle=\"round\", facecolor=\"white\", edgecolor=\"#999\"))\n",
        "ax.text(2.2, 1.75, \"P(J=T|A=T)=0.90\\nP(J=T|A=F)=0.05\", ha=\"center\", va=\"top\",\n",
        "        fontsize=8.5, bbox=dict(boxstyle=\"round\", facecolor=\"white\", edgecolor=\"#999\"))\n",
        "ax.text(7.8, 1.75, \"P(M=T|A=T)=0.70\\nP(M=T|A=F)=0.01\", ha=\"center\", va=\"top\",\n",
        "        fontsize=8.5, bbox=dict(boxstyle=\"round\", facecolor=\"white\", edgecolor=\"#999\"))\n",
        "ax.set_title(\"Bayesian Belief Network — Burglary Alarm Domain\", fontsize=14, fontweight=\"bold\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. EXPERIMENT 1 — Inference under different evidence conditions\n",
        "# ------------------------------------------------------------\n",
        "print(\"=\" * 70)\n",
        "print(\"EXPERIMENT 1: Inference under different evidence conditions\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "scenarios = [\n",
        "    (\"No evidence (prior)\",                          {}),\n",
        "    (\"Earthquake = True (causal: E -> A)\",            {\"E\": True}),\n",
        "    (\"JohnCalls = True (diagnostic: J -> A -> B,E)\",  {\"J\": True}),\n",
        "    (\"JohnCalls = True, MaryCalls = True\",            {\"J\": True, \"M\": True}),\n",
        "    (\"John=T, Mary=T, Earthquake=T (explaining away)\",{\"J\": True, \"M\": True, \"E\": True}),\n",
        "    (\"Alarm = True directly observed\",                {\"A\": True}),\n",
        "    (\"Alarm = False directly observed\",               {\"A\": False}),\n",
        "    (\"JohnCalls = False, MaryCalls = False\",          {\"J\": False, \"M\": False}),\n",
        "]\n",
        "\n",
        "def fmt(var, ev, cpts):\n",
        "    if var in ev:\n",
        "        return f\"{1.0 if ev[var] else 0.0:.6f}*\"\n",
        "    return f\"{query(var, {k: v for k, v in ev.items() if k != var}, cpts):.6f}\"\n",
        "\n",
        "print(f\"{'Scenario':55s} {'P(B=T)':>11s} {'P(E=T)':>11s} {'P(A=T)':>11s}\")\n",
        "print(\"-\" * 90)\n",
        "for name, ev in scenarios:\n",
        "    print(f\"{name:55s} {fmt('B', ev, cpts):>11s} {fmt('E', ev, cpts):>11s} {fmt('A', ev, cpts):>11s}\")\n",
        "print(\"(* = given as evidence, not inferred)\\n\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. EXPERIMENT 2 — Modifying CPTs, observing posterior change\n",
        "# ------------------------------------------------------------\n",
        "print(\"=\" * 70)\n",
        "print(\"EXPERIMENT 2: Modifying conditional probabilities\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "evidence_jm = {\"J\": True, \"M\": True}\n",
        "baseline_p = query(\"B\", evidence_jm, cpts)\n",
        "\n",
        "mods = {}\n",
        "\n",
        "cptsA = copy.deepcopy(cpts); cptsA[\"A\"][(False, False)] = 0.05\n",
        "mods[\"A: false-alarm rate 0.001 -> 0.05\"] = cptsA\n",
        "\n",
        "cptsB = copy.deepcopy(cpts)\n",
        "cptsB[\"A\"][(True, True)] = 0.999\n",
        "cptsB[\"A\"][(True, False)] = 0.999\n",
        "mods[\"B: true-positive rate 0.94-0.95 -> 0.999\"] = cptsB\n",
        "\n",
        "cptsC = copy.deepcopy(cpts); cptsC[\"B\"][()] = 0.01\n",
        "mods[\"C: prior P(Burglary) 0.001 -> 0.01\"] = cptsC\n",
        "\n",
        "cptsD = copy.deepcopy(cpts); cptsD[\"J\"][(True,)] = 0.50\n",
        "mods[\"D: P(JohnCalls=T|Alarm=T) 0.90 -> 0.50\"] = cptsD\n",
        "\n",
        "print(f\"Baseline P(B=T | J=T, M=T) = {baseline_p:.6f}\\n\")\n",
        "print(f\"{'Modification':45s} {'New posterior':>15s} {'Delta':>12s} {'% change':>10s}\")\n",
        "print(\"-\" * 86)\n",
        "for name, c in mods.items():\n",
        "    p = query(\"B\", evidence_jm, c)\n",
        "    delta = p - baseline_p\n",
        "    pct = 100 * delta / baseline_p\n",
        "    print(f\"{name:45s} {p:15.6f} {delta:12.6f} {pct:9.2f}%\")\n",
        "print()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. EXPERIMENT 3 — Sensitivity / robustness sweeps\n",
        "# ------------------------------------------------------------\n",
        "print(\"=\" * 70)\n",
        "print(\"EXPERIMENT 3: Sensitivity / robustness analysis\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "fa_range = np.linspace(0.0001, 0.10, 60)\n",
        "fa_posterior = []\n",
        "for fa in fa_range:\n",
        "    c = copy.deepcopy(cpts); c[\"A\"][(False, False)] = fa\n",
        "    fa_posterior.append(query(\"B\", evidence_jm, c))\n",
        "\n",
        "prior_range = np.geomspace(0.0001, 0.1, 60)\n",
        "prior_posterior = []\n",
        "for pr in prior_range:\n",
        "    c = copy.deepcopy(cpts); c[\"B\"][()] = pr\n",
        "    prior_posterior.append(query(\"B\", evidence_jm, c))\n",
        "\n",
        "john_range = np.linspace(0.05, 0.99, 60)\n",
        "john_posterior = []\n",
        "for jr in john_range:\n",
        "    c = copy.deepcopy(cpts); c[\"J\"][(True,)] = jr\n",
        "    john_posterior.append(query(\"B\", evidence_jm, c))\n",
        "\n",
        "tp_range = np.linspace(0.5, 0.999, 60)\n",
        "p_with_eq, p_without_eq = [], []\n",
        "for tp in tp_range:\n",
        "    c = copy.deepcopy(cpts)\n",
        "    c[\"A\"][(True, True)] = tp\n",
        "    c[\"A\"][(True, False)] = tp\n",
        "    p_with_eq.append(query(\"B\", {\"J\": True, \"M\": True, \"E\": True}, c))\n",
        "    p_without_eq.append(query(\"B\", {\"J\": True, \"M\": True, \"E\": False}, c))\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 9))\n",
        "\n",
        "axes[0, 0].plot(fa_range, fa_posterior, color=\"#c0392b\", linewidth=2)\n",
        "axes[0, 0].set_xlabel(\"P(Alarm=T | Burglary=F, Earthquake=F)  [false-alarm rate]\")\n",
        "axes[0, 0].set_ylabel(\"P(Burglary=T | John=T, Mary=T)\")\n",
        "axes[0, 0].set_title(\"Sensitivity to false-alarm rate\")\n",
        "axes[0, 0].axvline(0.001, color=\"gray\", linestyle=\"--\", linewidth=1, label=\"baseline\")\n",
        "axes[0, 0].legend(); axes[0, 0].grid(alpha=0.3)\n",
        "\n",
        "axes[0, 1].plot(prior_range, prior_posterior, color=\"#2980b9\", linewidth=2)\n",
        "axes[0, 1].set_xscale(\"log\")\n",
        "axes[0, 1].set_xlabel(\"Prior P(Burglary=T)  [log scale]\")\n",
        "axes[0, 1].set_ylabel(\"P(Burglary=T | John=T, Mary=T)\")\n",
        "axes[0, 1].set_title(\"Sensitivity to prior belief\")\n",
        "axes[0, 1].axvline(0.001, color=\"gray\", linestyle=\"--\", linewidth=1, label=\"baseline\")\n",
        "axes[0, 1].legend(); axes[0, 1].grid(alpha=0.3)\n",
        "\n",
        "axes[1, 0].plot(john_range, john_posterior, color=\"#27ae60\", linewidth=2)\n",
        "axes[1, 0].set_xlabel(\"P(JohnCalls=T | Alarm=T)  [witness reliability]\")\n",
        "axes[1, 0].set_ylabel(\"P(Burglary=T | John=T, Mary=T)\")\n",
        "axes[1, 0].set_title(\"Sensitivity to witness reliability\")\n",
        "axes[1, 0].axvline(0.90, color=\"gray\", linestyle=\"--\", linewidth=1, label=\"baseline\")\n",
        "axes[1, 0].legend(); axes[1, 0].grid(alpha=0.3)\n",
        "\n",
        "axes[1, 1].plot(tp_range, p_with_eq, color=\"#8e44ad\", linewidth=2, label=\"Earthquake = True\")\n",
        "axes[1, 1].plot(tp_range, p_without_eq, color=\"#f39c12\", linewidth=2, label=\"Earthquake = False\")\n",
        "axes[1, 1].set_xlabel(\"Alarm true-positive rate P(A=T | B=T, E)\")\n",
        "axes[1, 1].set_ylabel(\"P(Burglary=T | John=T, Mary=T)\")\n",
        "axes[1, 1].set_title(\"Explaining-away gap vs. alarm reliability\")\n",
        "axes[1, 1].legend(); axes[1, 1].grid(alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "def summarize(name, x, y):\n",
        "    y = np.array(y); x = np.array(x)\n",
        "    slope = np.gradient(y, x)\n",
        "    print(f\"{name:32s} range=[{y.min():.4f}, {y.max():.4f}]  \"\n",
        "            f\"span={y.max()-y.min():.4f}  max|slope|={np.max(np.abs(slope)):.4f}\")\n",
        "\n",
        "print()\n",
        "summarize(\"False-alarm rate sweep\", fa_range, fa_posterior)\n",
        "summarize(\"Prior sweep\", prior_range, prior_posterior)\n",
        "summarize(\"Witness reliability sweep\", john_range, john_posterior)\n",
        "summarize(\"Explaining-away (E=True)\", tp_range, p_with_eq)\n",
        "summarize(\"Explaining-away (E=False)\", tp_range, p_without_eq)\n",
        "\n",
        "print(\"\\nDone. See the two figures above for the network diagram and sensitivity plots.\")"
      ]
